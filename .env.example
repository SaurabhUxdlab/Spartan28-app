# Spartan 28 Firebase Configuration
# Copy this file to .env and configure with your Firebase Project credentials:

VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=spartan28-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spartan28-app
VITE_FIREBASE_STORAGE_BUCKET=spartan28-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
